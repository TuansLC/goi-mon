# --- Database (PostgreSQL, async driver) ---
DATABASE_URL=postgresql+asyncpg://qorder:qorder@localhost:5432/qorder

# --- Redis (Pub/Sub + cache) ---
REDIS_URL=redis://localhost:6379/0

# --- Auth / JWT ---
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=720

# --- WebSocket one-shot ticket TTL (seconds) ---
WS_TICKET_TTL_SECONDS=30

# --- Scheduler ---
ABANDON_SWEEP_INTERVAL_MINUTES=5
SCHEDULER_LOCK_TTL_SECONDS=300

# --- App meta ---
APP_NAME=QOrder API
DEBUG=false

# --- MinIO / S3 object storage ---
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=qorder-assets
S3_PUBLIC_URL=http://localhost:9000
